{
  "name": "slsdk-ts",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/src/ui/index.d.ts",
      "import": "./dist/ui.js"
    },
    "./server": {
      "types": "./dist/src/server/index.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "i18next": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.3.0",
    "@rslib/core": "^0.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "i18next": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
