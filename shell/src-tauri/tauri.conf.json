{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "superlive",
  "version": "0.2.0",
  "identifier": "tech.zhuozhuo.superlive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "superlive",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": []
  }
}
