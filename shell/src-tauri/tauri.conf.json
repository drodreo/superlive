{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Superlive",
  "identifier": "tech.zhuozhuo.superlive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Superlive",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5MUJEQjdEOThEQjEyRTQKUldUa0V0dVlmZHNieVRQcEZ5ZDYrY29kU3hIZzBTNE1kTUJXRlkzZGxISit1K05Mc3JNZ0g0alUK",
      "endpoints": [
        "https://github.com/drodreo/superlive/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
